# Project Info
PROJECT_NAME=Tasks API
VERSION=1.0.0
DESCRIPTION=A FastAPI application for managing tasks

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Environment
ENVIRONMENT=development
DEBUG=true

# CORS - Comma-separated list of allowed origins
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Database (REQUIRED - Get from Neon.tech or your PostgreSQL provider)

# Security (Change these in production!)
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Task Settings
MAX_TASKS_PER_USER=100
DEFAULT_TASK_STATUS=pending
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# To generate a secure SECRET_KEY, run the following command in your terminal:
SECRET_KEY=openssl rand -hex 32