# Tasks API Environment Configuration
# Copy this file to .env and update values for local development
# In production, use HashiCorp Vault for secrets management

# =============================================================================
# NON-SENSITIVE CONFIGURATION
# =============================================================================

# Project Info
PROJECT_NAME=Tasks API
VERSION=1.0.0
DESCRIPTION=A FastAPI application for managing tasks

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=true

# CORS - JSON array of allowed origins
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]

# JWT Settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Task Settings
MAX_TASKS_PER_USER=100
DEFAULT_TASK_STATUS=pending

# =============================================================================
# SECRETS - For local development only
# In production, these are injected by Vault Agent Sidecar
# =============================================================================

# Database URL (PostgreSQL)
# Format: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tasksdb

# JWT Secret Key
# Generate with: openssl rand -hex 32
SECRET_KEY=

# =============================================================================
# VAULT CONFIGURATION (Production)
# =============================================================================
# When vault.enabled=true in Helm values, secrets are read from:
#   /vault/secrets/database_url
#   /vault/secrets/secret_key
#
# These files are injected by the Vault Agent Sidecar.
# See vault/setup-vault.sh for Vault configuration.
# =============================================================================
